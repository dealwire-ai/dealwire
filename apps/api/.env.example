# PostgreSQL connection string
# For local dev: postgresql://user:password@localhost:5432/dealwire?schema=public
# For Railway: Use the DATABASE_URL from your Railway PostgreSQL instance
DATABASE_URL="postgresql://user:password@localhost:5432/dealwire?schema=public"

# Resend Email Configuration
# NYC Open Data (Socrata) — optional but recommended to avoid rate limits
NYC_OPEN_DATA_APP_TOKEN="your-nyc-open-data-app-token-here"

# How often to check if digests are due (cron expression, default: every 30 min)
# Set to e.g. "*/2 * * * *" for faster checks during testing
DIGEST_CHECKER_CRON="*/30 * * * *"

# Anthropic (Claude) — used by underwriting pipeline
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# SQS — underwriting pipeline queue
AWS_UNDERWRITING_QUEUE_URL="https://sqs.us-east-1.amazonaws.com/128458832204/underwriting"

RESEND_API_KEY="your-resend-api-key-here"
RESEND_WEBHOOK_SECRET="your-resend-webhook-secret-here"
FROM_EMAIL="Dealwire <mail.deals@mail.dealwire.ai>"
# Resend inbound address for underwriting submissions (e.g. underwriting@inbound.yourdomain.com)
UNDERWRITING_INBOUND_EMAIL="underwriting@mail.dealwire.ai"
# Resend inbound address for screening preference commands (e.g. screening@mail.dealwire.ai)
SCREENING_INBOUND_EMAIL="screening@mail.dealwire.ai"

# Tracerfy skip tracing (owner contact lookup)
TRACERFY_API_KEY=                    # Bearer token from Tracerfy dashboard
TRACERFY_MONTHLY_CREDIT_CAP=500      # Max credits/month (1 credit = $0.02). Default: 500 = $10/mo
# Configure webhook URL in Tracerfy account settings: https://tracerfy.com/settings/api/
# Set to: https://your-api-domain.com/webhooks/tracerfy

# Per-org monthly skip trace limit (default: 100 traces/month)
ORG_SKIP_TRACE_MONTHLY_LIMIT=100

# Skip Sherpa fallback skip tracing (runs on Tracerfy misses)
SKIPSHERPA_API_KEY=                  # API key from skipsherpa.com dashboard

# Public Data Auto-Refresh
PUBLIC_DATA_AUTO_REFRESH_ENABLED=false  # Set to "true" to enable scheduled ingestion
PUBLIC_DATA_REFRESH_CRON="0 3 * * 0"   # Cron schedule (default: Sunday 3am UTC)

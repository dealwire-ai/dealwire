{
  "name": "@dealwire/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "(prisma migrate resolve --rolled-back 20260425000000_add_parcel_crm_tables || true) && prisma migrate deploy && node dist/src/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:migrate:prod": "sh -c 'read -sp \"Supabase password: \" PW && echo && PW_ENC=$(python3 -c \"import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1],safe=\\\"\\\")); \" \"$PW\") && DATABASE_URL=\"postgresql://postgres.icujkrafywivakbfrerg:${PW_ENC}@aws-1-us-east-1.pooler.supabase.com:5432/postgres\" DIRECT_URL=\"postgresql://postgres.icujkrafywivakbfrerg:${PW_ENC}@aws-1-us-east-1.pooler.supabase.com:5432/postgres\" prisma migrate deploy'",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPatterns=integration",
    "test:localstack:up": "docker compose -f docker-compose.test.yml up -d",
    "test:localstack:down": "docker compose -f docker-compose.test.yml down",
    "send-test-email": "bash scripts/send-test-email.sh",
    "send-test-digest": "bash scripts/send-test-digest.sh",
    "demo": "bash scripts/demo.sh"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/openai": "^1.3.24",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/client-sqs": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@clerk/backend": "^2.29.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^6.19.3",
    "@ssut/nestjs-sqs": "^3.0.1",
    "@types/cheerio": "^1.0.0",
    "ai": "^4.3.19",
    "cheerio": "^1.2.0",
    "cron": "^4.4.0",
    "cron-parser": "^5.6.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "marked": "^17.0.1",
    "openai": "^6.45.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.16.0",
    "rxjs": "^7.8.1",
    "svix": "^1.96.1",
    "xlsx": "^0.18.5",
    "xlsx-populate": "^1.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.17",
    "@types/supertest": "^7.2.0",
    "@types/xlsx": "^0.0.36",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jiti": "^2.7.0",
    "prettier": "^3.9.3",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testMatch": [
      "**/*.spec.ts",
      "**/test/**/*.spec.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "sqs.integration.spec"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "strict": false,
            "noImplicitAny": false,
            "strictNullChecks": false
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    }
  }
}

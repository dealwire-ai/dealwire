generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String        @id
  email          String        @unique
  firstName      String?
  lastName       String?
  imageUrl       String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  microsoftSubscription MicrosoftSubscription?
  receivedDeals         Deal[]                 @relation("ReceivedDeals")
  triggeredIngestions   HistoricalIngestion[]  @relation("TriggeredIngestions")

  parcelDealsAssigned      ParcelDeal[]     @relation("ParcelDealAssignedTo")
  parcelDealsAssignedBy    ParcelDeal[]     @relation("ParcelDealAssignedBy")
  parcelDealsLastContacted ParcelDeal[]     @relation("ParcelDealLastContactedBy")
  parcelActivities         ParcelActivity[]
}

model Organization {
  id                   String                @id
  name                 String
  slug                 String?               @unique
  imageUrl             String?
  featureFlags         Json? // { parcels?: boolean, ... } — merged with defaults at app layer
  users                User[]
  deals                Deal[]
  screeningPreferences ScreeningPreferences?
  screeningBuckets     ScreeningBucket[]
  historicalIngestions HistoricalIngestion[]
  proformas            Proforma[]
  underwritingRuns     UnderwritingRun[]
  parcelDealStages     ParcelDealStage[]
  parcelDeals          ParcelDeal[]
  parcelActivities     ParcelActivity[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model MicrosoftSubscription {
  id             String   @id @default(cuid())
  userId         String   @unique
  subscriptionId String   @unique // Graph subscription ID
  resource       String // e.g. "me/mailFolders('Inbox')/messages"
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// DEAL - An acquisition opportunity
// ============================================
model Deal {
  id String @id @default(cuid())

  // Belongs to an org (team can all see it)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Which user's inbox did this come from?
  receivedByUserId String?
  receivedByUser   User?   @relation("ReceivedDeals", fields: [receivedByUserId], references: [id])

  // Source email info
  sourceMessageId  String?   @unique // Microsoft Graph message ID
  sourceFrom       String? // Who sent it
  sourceSubject    String?
  sourceReceivedAt DateTime?

  // Detection metadata
  detectionConfidence String? // high/medium/low
  detectionReason     String? @db.Text // Why it was classified as a deal
  folderMovedTo       String? // Folder name if moved (e.g., "Passed Deals")

  // Structured extracted data
  dealType      String? // "real_estate", "debt", "business", "unknown"
  extractedData Json? // Typed at app layer per dealType

  // Action card data (captured at processing time for digest)
  sourceWebLink  String? // Outlook Web link to original email
  sourceEntryId  String? // MAPI entry ID (hex) for outlook: protocol deep link
  extractedLinks Json? // { dealRoomLinks: string[], caLinks: string[], listingLinks: string[] }

  // Relationships
  asset            Asset?            @relation(fields: [assetId], references: [id])
  assetId          String?
  contact          Contact?          @relation(fields: [contactId], references: [id])
  contactId        String?
  documents        Document[]
  initialScreening InitialScreening?
  underwritingRuns UnderwritingRun[]

  isMuted     Boolean   @default(false)
  mutedAt     DateTime?
  mutedReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

enum Decision {
  YES
  NO
}

enum BucketAction {
  REPLY_TO_SELF
  DRAFT_REPLY_TO_BROKER
  MOVE_TO_FOLDER
  NONE
}

// ============================================
// INITIAL SCREENING - Screening result for a deal
// ============================================
model InitialScreening {
  id String @id @default(cuid())

  // One-to-one with Deal
  dealId String @unique
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  // Screening result
  decision Decision // YES or NO (derived from bucket.isPass)
  reason   String   @db.Text // One-sentence reason from screening

  // Bucket classification
  screeningBucketId String?
  screeningBucket   ScreeningBucket? @relation(fields: [screeningBucketId], references: [id], onDelete: SetNull)

  // When screening was performed
  screenedAt DateTime @default(now())

  // Digest tracking
  digestSent   Boolean   @default(false) // Whether this screening has been included in a digest
  digestSentAt DateTime? // Timestamp when digest was sent (optional, for audit)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId, digestSent, digestSentAt])
  @@index([dealId, digestSent, screenedAt])
}

// ============================================
// SCREENING BUCKET - Customizable deal classification tier
// ============================================
model ScreeningBucket {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String // "Hot Deal", "Good Fit", "Pass"
  description     String       @db.Text // Criteria for AI classification
  rank            Int // 1 = highest priority
  isPass          Boolean // true = Decision.YES, false = Decision.NO
  action          BucketAction @default(NONE)
  folderName      String? // For MOVE_TO_FOLDER action
  generateSummary Boolean      @default(false)
  color           String? // Hex color for UI/email

  initialScreenings InitialScreening[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// ============================================
// ASSET - The thing being acquired
// ============================================
model Asset {
  id String @id @default(cuid())

  address String?
  city    String?
  state   String?
  country String? @default("USA")

  normalizedAddress String? @unique // Normalized address for matching (e.g., "123 MAIN ST, NEW YORK, NY, USA")

  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([normalizedAddress])
}

// ============================================
// CONTACT - Broker/contact who sent the deal
// ============================================
model Contact {
  id String @id @default(cuid())

  email     String   @unique // Normalized email (lowercase, trimmed) - used as unique key
  firstName String?
  lastName  String?
  notes     String?  @db.Text // Freeform broker notes (e.g., "just had a baby, likes the Knicks")
  tags      String[] @default([]) // Tags like "top broker", "responsive", etc.

  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ============================================
// DOCUMENT - Any file attached to a deal
// ============================================
model Document {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  filename    String
  contentType String
  sizeBytes   Int?

  s3Key String?

  createdAt DateTime @default(now())

  @@index([dealId])
}

// ============================================
// SCREENING PREFERENCES - Organization settings
// ============================================
// ============================================
// HISTORICAL INGESTION - Batch inbox processing job
// ============================================
enum IngestionStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

model HistoricalIngestion {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  triggeredByUserId String
  triggeredByUser   User         @relation("TriggeredIngestions", fields: [triggeredByUserId], references: [id])

  // Config
  startDate  DateTime?
  endDate    DateTime?
  folderName String    @default("Inbox")

  // Progress
  status         IngestionStatus @default(PENDING)
  totalMessages  Int?
  scannedCount   Int             @default(0)
  detectedCount  Int             @default(0)
  processedCount Int             @default(0)
  skippedCount   Int             @default(0)
  errorCount     Int             @default(0)

  // Resumability
  nextLink               String? @db.Text
  lastProcessedMessageId String?
  lastError              String? @db.Text

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([organizationId, status])
}

model ScreeningPreferences {
  id                              String       @id @default(cuid())
  organizationId                  String       @unique
  organization                    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyName                     String?
  brandColor                      String? // Hex code
  passedFolderName                String?
  dealCriteria                    String?      @db.Text
  skipCriteria                    String?      @db.Text // Free-text criteria for the LLM to interpret (e.g. "retail deals", "deals under 40 units")
  knownProperties                 String?      @db.Text // Structured list of property names/addresses to skip via regex (one per line)
  skipKeywords                    String?      @db.Text // Literal phrases to skip via regex before the LLM (one per line, e.g. "NNN", "single tenant")
  digestSchedule                  String? // CRON expression (e.g., "0 12 * * *" for daily at noon)
  digestTimeZone                  String?      @default("America/New_York") // Timezone for schedule
  designatedMonitoringInboxEmails String[]     @default([]) // If non-empty, only these users' inboxes are monitored; falls back to oldest connected user
  createdAt                       DateTime     @default(now())
  updatedAt                       DateTime     @updatedAt
}

// ============================================
// PROFORMA - Pro forma Excel template per org
// ============================================
model Proforma {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String // e.g. "Standard Multifamily Model"
  s3Key String // S3 path to the .xlsx template file

  // Cell mapping: array of { extractedField, sheet, cell, label }
  // extractedField keys match the canonical extraction output schema.
  // e.g. [{ "extractedField": "om.askingPrice", "sheet": "Assumptions", "cell": "B5", "label": "Purchase Price" }]
  fieldMap Json @default("[]")

  isDefault Boolean @default(false) // Pipeline uses this template when org has multiple
  isReady   Boolean @default(false) // False until fieldMap is confirmed via onboarding

  underwritingRuns UnderwritingRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// ============================================
// PARCEL - Public data record for a tax parcel (by BBL)
// ============================================
model Parcel {
  id String @id @default(cuid())

  // BBL (Borough-Block-Lot) — unique tax parcel identifier
  borough String // "1"=Manhattan, "2"=Bronx, "3"=Brooklyn, "4"=Queens, "5"=Staten Island
  block   String
  lot     String
  bbl     String @unique // Composite 10-char: borough(1) + block(5, zero-padded) + lot(4, zero-padded)

  // Address
  address String?
  zipCode String?
  city    String? // Derived from borough for NYC (e.g. "Brooklyn")
  state   String? // "NY" for all NYC parcels

  // PLUTO data (property characteristics from NYC Dept of City Planning)
  buildingClass String?
  unitsTotal    Int?
  unitsRes      Int?
  buildingArea  Int? // sqft
  lotArea       Int? // sqft
  lotFront      Float? // ft (PLUTO lotfront)
  lotDepth      Float? // ft (PLUTO lotdepth)
  bldgFront     Float? // ft (PLUTO bldgfront)
  bldgDepth     Float? // ft (PLUTO bldgdepth)
  latitude      Float? // PLUTO latitude (decimal degrees, NAD83)
  longitude     Float? // PLUTO longitude (decimal degrees, NAD83)
  numFloors     Float?
  yearBuilt     Int?
  ownerName     String?
  zoneDist1     String?
  landUse       String?
  assessTotal   Float? // Total assessed value (from DOF)
  taxClass      String?

  // Computed / enriched
  estimatedMarketValue Float? // assessTotal / rate (0.06 for class 1, 0.45 for class 2-4)
  isCoopExcluded       Boolean @default(false) // True if buildingClass in coop exclusion list

  // Tax lien data (from NYC DOF lien sale list)
  hasActiveLien Boolean @default(false)
  lienCycle     String? // e.g., "90 Day Notice"
  waterDebtOnly Boolean @default(false)

  // Property charges (from DOF Property Charges Balance — Socrata scjx-j6np)
  outstandingTaxBill      Float? // Sum of CHG (property tax) balances
  totalOutstandingBalance Float? // Sum of ALL outstanding balances (CHG+SAC+SAF+SAT)
  chargesSyncedAt         DateTime? // When charges data was last synced

  // HPD Violations (aggregated counts per parcel)
  violationsTotal   Int    @default(0)
  violationsOpen    Int    @default(0)
  violationsClassA  Int    @default(0) // Non-hazardous
  violationsClassB  Int    @default(0) // Hazardous
  violationsClassC  Int    @default(0) // Immediately hazardous
  violationsPerUnit Float? // violationsOpen / unitsTotal

  // Distress score (0-100, higher = more distressed)
  distressScore Float?

  // Skip tracing (owner contact lookup via Tracerfy)
  ownerPhones      Json? // [{ number: string, type: string, rank: number }]
  ownerEmails      Json? // string[]
  skipTracedAt      DateTime?
  skipTraceStatus   String? // 'pending' | 'found' | 'not_found' | 'error'
  skipTraceQueuedAt DateTime? // set when status flips to 'pending'; cleared on completion

  // CARE portal scraper (exact per-BBL lien data)
  lienStatus         String? // Raw CARE status: "S Sold", "R Post Sale Redeemed"
  lienRedemptionDate String? // Date redeemed (if applicable)
  careSyncedAt       DateTime? // When CARE scraper last updated this parcel

  // NYCTL lien sale data (from quarterly status reports, crosswalk matched)
  lienSaleAmount        Float? // "Balance Sold" — $$ sold to NYCTL Trust
  lienRedemptiveValue   Float? // Current payoff amount (principal + interest + fees)
  lienServicer          String? // "MTAG" or "Tower"
  lienRedeemed          Boolean? // Has owner paid off the lien?
  lienForeclosureStatus String? // e.g., "Referred", "Active", null
  lienSaleDate          String? // When lien was sold
  lienTrustVintage      String? // e.g., "2025-A", "1998-2"
  lienMatchConfidence   String? // "exact", "group_small", "group_large", "estimated"
  lienMatchGroupSize    Int? // How many records shared the match key (1 = exact)
  nyctlSyncedAt         DateTime?

  // ATTOM valuation data (from /allevents/detail)
  avmValue      Float? // AVM estimated market value (condos/SFR only)
  avmHigh       Float? // AVM upper bound
  avmLow        Float? // AVM lower bound
  avmConfidence Int? // AVM confidence score 0-100
  avmDate       DateTime? // When ATTOM produced the AVM
  marketValue   Float? // ATTOM market total value (broader coverage than AVM)
  assessedValue Float? // Tax-assessed total value
  lastSalePrice Float? // Most recent sale amount
  lastSaleDate  DateTime? // Most recent sale date
  taxAmount     Float? // Annual property tax
  taxYear       Int? // Tax year
  avmSyncedAt   DateTime? // When we last fetched valuation data from ATTOM

  // Sync tracking
  plutoSyncedAt      DateTime?
  liensSyncedAt      DateTime?
  violationsSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Contact tracking (org-specific phone notes)
  phoneNotes PhoneNote[]

  // Property list assignments (org-specific categorization)
  listAssignments ParcelListAssignment[]

  // Org-scoped skip trace access (tracks which orgs have "unlocked" this parcel's contact data)
  orgSkipTraces OrgSkipTrace[]

  // Org-scoped AVM lookup tracking
  orgAvmLookups OrgAvmLookup[]

  // CRM (org-scoped pipeline + activity log)
  deals      ParcelDeal[]
  activities ParcelActivity[]

  @@index([borough])
  @@index([buildingClass])
  @@index([distressScore(sort: Desc)])
  @@index([hasActiveLien])
  @@index([borough, hasActiveLien])
}

enum ParcelListType {
  IMMEDIATE
  LONG_TERM
  NOT_INTERESTED
}

model ParcelListAssignment {
  id             String         @id @default(cuid())
  parcelId       String
  parcel         Parcel         @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  organizationId String
  listType       ParcelListType
  assignedBy     String // userId who assigned
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([parcelId, organizationId])
  @@index([organizationId, listType])
  @@index([parcelId])
}

model OrgSkipTrace {
  id             String   @id @default(cuid())
  parcelId       String
  parcel         Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  organizationId String
  tracedAt       DateTime @default(now())

  @@unique([parcelId, organizationId])
  @@index([organizationId, tracedAt])
  @@index([parcelId])
}

model OrgAvmLookup {
  id             String   @id @default(cuid())
  parcelId       String
  parcel         Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  organizationId String
  lookedUpAt     DateTime @default(now())

  @@unique([parcelId, organizationId])
  @@index([organizationId, lookedUpAt])
  @@index([parcelId])
}

enum PhoneStatus {
  GOOD
  BAD
  UNKNOWN
}

model PhoneNote {
  id             String      @id @default(cuid())
  parcelId       String
  parcel         Parcel      @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  phoneNumber    String // Exact string from ownerPhones[].number
  organizationId String
  status         PhoneStatus @default(UNKNOWN)
  note           String?     @db.Text
  userId         String
  userInitials   String // Denormalized "DS", "DG" for display
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([parcelId, phoneNumber, organizationId])
  @@index([parcelId, organizationId])
}

// ============================================
// PARCEL CRM — org-configurable pipeline + activity log
// ============================================

model ParcelDealStage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String? // hex e.g. "#22c55e" — UI tag color, optional
  order          Int // display order within org
  isDefault      Boolean      @default(false) // new deals land here
  isTerminal     Boolean      @default(false) // closed states (won / not interested)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  deals ParcelDeal[]

  @@unique([organizationId, order])
  @@unique([organizationId, name])
  @@index([organizationId])
}

model ParcelDeal {
  id             String       @id @default(cuid())
  parcelId       String
  parcel         Parcel       @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stageId String
  // Restrict so an org can't delete a stage that still holds deals — they must reassign first.
  stage   ParcelDealStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  // Assignment (nullable — a parcel can be in the pipeline but unassigned)
  assignedToUserId String?
  assignedToUser   User?     @relation("ParcelDealAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedByUserId String?
  assignedByUser   User?     @relation("ParcelDealAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  assignedAt       DateTime?

  // Denormalized contact summary (source of truth = ParcelActivity timeline)
  nextFollowUpAt        DateTime?
  lastContactedAt       DateTime?
  lastContactedByUserId String?
  lastContactedByUser   User?     @relation("ParcelDealLastContactedBy", fields: [lastContactedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parcelId, organizationId])
  @@index([organizationId, stageId])
  @@index([organizationId, assignedToUserId])
  @@index([organizationId, nextFollowUpAt])
}

enum ParcelActivityType {
  CALL
  NOTE
  STAGE_CHANGED
  ASSIGNED
  UNASSIGNED
  FOLLOWUP_SCHEDULED
  FOLLOWUP_COMPLETED
  PHONE_STATUS_CHANGED
}

model ParcelActivity {
  id             String       @id @default(cuid())
  parcelId       String
  parcel         Parcel       @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Actor (nullable so audit trail survives user deletion; userInitials preserved for display)
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userInitials String

  type ParcelActivityType
  body String?            @db.Text

  // Phone-related fields hoisted out of metadata so they're queryable
  phoneNumber String?
  phoneStatus PhoneStatus?

  // Type-specific extras: { fromStageId, toStageId, fromUserId, toUserId, followUpAt, ... }
  metadata Json?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([parcelId, organizationId, occurredAt(sort: Desc)])
  @@index([parcelId, phoneNumber, occurredAt(sort: Desc)])
  @@index([organizationId, type, occurredAt(sort: Desc)])
}

model IngestionRun {
  id          String    @id @default(cuid())
  trigger     String // "manual" | "scheduled"
  status      String // "running" | "success" | "failed"
  boroughs    String[] // ["1", "3", "4"]
  results     Json? // IngestionResult[] on completion
  error       String?   @db.Text
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([startedAt])
}

enum UnderwritingStatus {
  RUNNING
  WAITING_FOR_ASSUMPTIONS
  WAITING_FOR_CLARIFICATION
  COMPLETED
  FAILED
}

enum UnderwritingMessageDirection {
  INBOUND
  OUTBOUND
}

enum UnderwritingMessagePhase {
  ASK
  CLARIFY
  DELIVER
  REPLY
  ANSWER
}

model UnderwritingRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Domain relations (all optional — populated as data becomes available)
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id])
  proformaId String?
  proforma   Proforma? @relation(fields: [proformaId], references: [id])

  // Iteration chain: re-runs triggered by follow-up email replies link to the
  // original run via parentRunId. Each iteration is its own row for audit trail.
  parentRunId String?
  parent      UnderwritingRun?  @relation("RunIterations", fields: [parentRunId], references: [id], onDelete: Cascade)
  children    UnderwritingRun[] @relation("RunIterations")

  jobId        String  @unique // uw_ prefixed ID for S3 partitioning & SQS idempotency
  senderEmail  String // Keep — runs can exist without a Deal
  emailSubject String?

  status UnderwritingStatus @default(RUNNING)

  analysisData             Json?
  filledProformaModelS3Key String? // Filled proforma output (distinct from proforma.s3Key which is the template)
  humanReviewFlags         String[] @default([])
  confidence               Float?
  durationMs               Int?
  error                    String?  @db.Text

  // Interactive assumption loop state — populated when the pipeline pauses to
  // ask the user for investor assumptions and resumes after they reply.
  extractionSnapshot  Json? // Frozen DealAnalysis so the fill phase/re-runs skip re-analysis
  askedAssumptions    Json? // AssumptionQuestion[] sent in the ASK email
  receivedAssumptions Json? // UserAssumptions parsed from the reply

  // LLM cost/token rollup — populated when the run completes.
  // See docs/technical/GRAFANA_SETUP.md for the corresponding Prometheus metrics.
  totalPromptTokens     Int?
  totalCompletionTokens Int?
  totalLlmCostUsd       Decimal? @db.Decimal(10, 6)
  llmCostByStage        Json? // { "extraction.om": 0.0234, "field_mapping": 0.0012, ... }

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages UnderwritingRunMessage[]

  @@index([organizationId, status])
  @@index([organizationId, completedAt(sort: Desc)])
  @@index([dealId])
  @@index([parentRunId])
}

model UnderwritingRunMessage {
  id        String                       @id @default(cuid())
  runId     String
  run       UnderwritingRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  messageId String                       @unique // RFC 5322 Message-ID we generated (OUTBOUND) or received (INBOUND)
  direction UnderwritingMessageDirection
  phase     UnderwritingMessagePhase
  bodyText  String?                      @db.Text // Plain-text body, persisted for multi-turn conversation history
  sentAt    DateTime                     @default(now())

  @@index([runId, phase])
  @@index([runId, sentAt])
}

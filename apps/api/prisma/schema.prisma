generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String        @id
  email          String        @unique
  firstName      String?
  lastName       String?
  imageUrl       String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  microsoftSubscription  MicrosoftSubscription?
  receivedDeals          Deal[]                 @relation("ReceivedDeals")
  triggeredIngestions    HistoricalIngestion[]   @relation("TriggeredIngestions")
}

model Organization {
  id                  String                @id
  name                String
  slug                String?                @unique
  imageUrl            String?
  users                 User[]
  deals                 Deal[]
  screeningPreferences  ScreeningPreferences?
  screeningBuckets      ScreeningBucket[]
  historicalIngestions   HistoricalIngestion[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model MicrosoftSubscription {
  id             String   @id @default(cuid())
  userId         String   @unique
  subscriptionId String   @unique // Graph subscription ID
  resource       String // e.g. "me/mailFolders('Inbox')/messages"
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// DEAL - An acquisition opportunity
// ============================================
model Deal {
  id String @id @default(cuid())

  // Belongs to an org (team can all see it)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Which user's inbox did this come from?
  receivedByUserId String?
  receivedByUser   User?   @relation("ReceivedDeals", fields: [receivedByUserId], references: [id])

  // Source email info
  sourceMessageId  String?   @unique // Microsoft Graph message ID
  sourceFrom       String? // Who sent it
  sourceSubject    String?
  sourceReceivedAt DateTime?

  // Detection metadata
  detectionConfidence String? // high/medium/low
  detectionReason     String? @db.Text // Why it was classified as a deal
  folderMovedTo       String? // Folder name if moved (e.g., "Passed Deals")

  // Structured extracted data
  dealType      String? // "real_estate", "debt", "business", "unknown"
  extractedData Json? // Typed at app layer per dealType

  // Relationships
  asset             Asset?             @relation(fields: [assetId], references: [id])
  assetId           String?
  contact           Contact?           @relation(fields: [contactId], references: [id])
  contactId         String?
  documents         Document[]
  initialScreening  InitialScreening?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Decision {
  YES
  NO
}

enum BucketAction {
  REPLY_TO_SELF
  DRAFT_REPLY_TO_BROKER
  MOVE_TO_FOLDER
  NONE
}

// ============================================
// INITIAL SCREENING - Screening result for a deal
// ============================================
model InitialScreening {
  id String @id @default(cuid())

  // One-to-one with Deal
  dealId String @unique
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  // Screening result
  decision Decision // YES or NO (derived from bucket.isPass)
  reason   String   @db.Text // One-sentence reason from screening

  // Bucket classification
  screeningBucketId String?
  screeningBucket   ScreeningBucket? @relation(fields: [screeningBucketId], references: [id], onDelete: SetNull)

  // When screening was performed
  screenedAt DateTime @default(now())

  // Digest tracking
  digestSent   Boolean   @default(false) // Whether this screening has been included in a digest
  digestSentAt DateTime? // Timestamp when digest was sent (optional, for audit)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId, digestSent, digestSentAt])
  @@index([dealId, digestSent, screenedAt])
}

// ============================================
// SCREENING BUCKET - Customizable deal classification tier
// ============================================
model ScreeningBucket {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String       // "Hot Deal", "Good Fit", "Pass"
  description     String       @db.Text  // Criteria for AI classification
  rank            Int          // 1 = highest priority
  isPass          Boolean      // true = Decision.YES, false = Decision.NO
  action          BucketAction @default(NONE)
  folderName      String?      // For MOVE_TO_FOLDER action
  generateSummary Boolean      @default(false)
  color           String?      // Hex color for UI/email

  initialScreenings InitialScreening[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// ============================================
// ASSET - The thing being acquired
// ============================================
model Asset {
  id String @id @default(cuid())

  address String?
  city    String?
  state   String?
  country String? @default("USA")

  normalizedAddress String? @unique // Normalized address for matching (e.g., "123 MAIN ST, NEW YORK, NY, USA")

  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([normalizedAddress])
}

// ============================================
// CONTACT - Broker/contact who sent the deal
// ============================================
model Contact {
  id String @id @default(cuid())

  email String @unique // Normalized email (lowercase, trimmed) - used as unique key
  firstName String?
  lastName  String?

  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ============================================
// DOCUMENT - Any file attached to a deal
// ============================================
model Document {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  filename    String
  contentType String
  sizeBytes   Int?

  s3Key String?

  createdAt DateTime @default(now())
}

// ============================================
// SCREENING PREFERENCES - Organization settings
// ============================================
// ============================================
// HISTORICAL INGESTION - Batch inbox processing job
// ============================================
enum IngestionStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

model HistoricalIngestion {
  id                     String          @id @default(cuid())
  organizationId         String
  organization           Organization    @relation(fields: [organizationId], references: [id])
  triggeredByUserId      String
  triggeredByUser        User            @relation("TriggeredIngestions", fields: [triggeredByUserId], references: [id])

  // Config
  startDate              DateTime?
  endDate                DateTime?
  folderName             String          @default("Inbox")

  // Progress
  status                 IngestionStatus @default(PENDING)
  totalMessages          Int?
  scannedCount           Int             @default(0)
  detectedCount          Int             @default(0)
  processedCount         Int             @default(0)
  skippedCount           Int             @default(0)
  errorCount             Int             @default(0)

  // Resumability
  nextLink               String?         @db.Text
  lastProcessedMessageId String?
  lastError              String?         @db.Text

  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([organizationId, status])
}

model ScreeningPreferences {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyName     String?
  brandColor      String? // Hex code
  passedFolderName String?
  dealCriteria    String?       @db.Text
  alwaysSkip      String?       @db.Text // Criteria for deals to always skip
  digestSchedule  String? // CRON expression (e.g., "0 12 * * *" for daily at noon)
  digestTimeZone  String?  @default("America/New_York") // Timezone for schedule
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

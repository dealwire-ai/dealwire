generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id
  email          String   @unique
  firstName      String?
  lastName       String?
  imageUrl       String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Organization {
  id        String   @id
  name      String
  slug      String?  @unique
  imageUrl  String?
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}





